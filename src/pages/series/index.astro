---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../site.config';
import { formatDate, getPostsInSeries, getSeriesPath, sortPosts, withBasePath } from '../../utils/content';
import { getBreadcrumbJsonLd } from '../../utils/structured-data';

const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const allSeries = await getCollection('series', ({ data }) => !data.draft);
const seriesRows = allSeries
  .map((entry) => {
    const seriesPosts = getPostsInSeries(posts, entry.id);
    const latest = seriesPosts[seriesPosts.length - 1];

    return {
      entry,
      count: seriesPosts.length,
      href: getSeriesPath(entry.id),
      updatedLabel: latest ? formatDate(latest.data.date, 'en') : undefined
    };
  })
  .filter((row) => row.count > 0)
  .sort((left, right) => {
    if (left.entry.data.featured !== right.entry.data.featured) {
      return left.entry.data.featured ? -1 : 1;
    }

    return left.entry.data.title.localeCompare(right.entry.data.title);
  });

const siteOrigin = Astro.site ?? new URL(siteConfig.siteUrl);
const jsonLd = [
  getBreadcrumbJsonLd([
    { name: 'Home', url: new URL(import.meta.env.BASE_URL, siteOrigin).toString() },
    { name: 'Series', url: new URL('series/', new URL(import.meta.env.BASE_URL, siteOrigin)).toString() }
  ])
];
---

<BaseLayout
  title="Series"
  description="Multi-part collections of essays, each following one theme from start to finish."
  keywords={['series', 'collections', 'blog']}
  jsonLd={jsonLd}
>
  <section class="editorial-hero">
    <div class="editorial-hero-main">
      <p class="eyebrow">Series</p>
      <h1>One theme, followed through.</h1>
    </div>
    <div class="editorial-hero-side">
      <p class="section-copy">
        Multi-part collections. Each series takes a single question and works it through in order.
      </p>
      <div class="hero-links">
        <a class="text-link" href={withBasePath('/blog/')}>Browse all essays instead</a>
      </div>
    </div>
  </section>

  <section class="directory-shell">
    {seriesRows.length > 0 ? (
      <div class="series-list">
        {seriesRows.map((row, index) => (
          <article class="series-row">
            <p class="series-index">{String(index + 1).padStart(2, '0')}</p>
            <div class="series-row-body">
              <h2>
                <a href={row.href}>{row.entry.data.title}</a>
              </h2>
              <p class="series-row-description">{row.entry.data.description}</p>
              <p class="series-row-meta">
                <span>{row.count} {row.count === 1 ? 'part' : 'parts'}</span>
                {row.updatedLabel && <span>Updated {row.updatedLabel}</span>}
              </p>
            </div>
            <a class="series-row-link text-link" href={row.href}>Open series</a>
          </article>
        ))}
      </div>
    ) : (
      <p class="search-note">No series yet. Group posts by adding a `series` field to their frontmatter.</p>
    )}
  </section>
</BaseLayout>
