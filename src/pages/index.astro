---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { siteConfig } from '../site.config';
import { buildSearchDocument } from '../utils/search';
import { collectTags, formatDate, getPostsInSeries, getSeriesPath, getSeriesUpdatedDate, sortPosts, withBasePath } from '../utils/content';

const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const featuredPosts = posts.filter((post) => post.data.featured);
const latestSource = featuredPosts.length > 0
  ? [
      ...featuredPosts,
      ...posts.filter((post) => !post.data.featured)
    ].slice(0, 4)
  : posts.slice(0, 4);
const latestDocuments = latestSource.map((post) => buildSearchDocument(post));
const tags = collectTags(posts).slice(0, 8);

const seriesRows = (await getCollection('series', ({ data }) => !data.draft))
  .map((entry) => {
    const seriesPosts = getPostsInSeries(posts, entry.id);
    const updatedAt = getSeriesUpdatedDate(seriesPosts);

    return {
      entry,
      count: seriesPosts.length,
      href: getSeriesPath(entry.id),
      updatedLabel: updatedAt ? formatDate(updatedAt, 'en') : undefined,
      latestDate: updatedAt?.valueOf() ?? 0
    };
  })
  .filter((row) => row.count > 0)
  .sort((left, right) => right.latestDate - left.latestDate)
  .slice(0, 4);
---

<BaseLayout lang="zh-CN">
  <section class="editorial-hero home-hero">
    <div class="editorial-hero-main">
      <p class="eyebrow">{siteConfig.hero.eyebrow}</p>
      <h1>{siteConfig.hero.headline}</h1>
      <p class="section-copy">{siteConfig.hero.lead}</p>
    </div>

    <div class="editorial-hero-side">
      <p class="hero-note">{siteConfig.hero.deck}</p>
      <p class="hero-signature">{siteConfig.hero.signature}</p>

      <div class="hero-links">
        <a class="text-link" href={withBasePath('/blog/')}>Browse the archive</a>
        <a class="text-link" href={withBasePath('/about/')}>About the author</a>
      </div>
    </div>
  </section>

  <section class="directory-shell home-directory-shell">
    <div class="directory-toolbar">
      <div class="directory-toolbar-copy">
        <p class="eyebrow">{featuredPosts.length > 0 ? 'Selected writing' : 'Recent writing'}</p>
        <div class="directory-toolbar-meta">
          <a class="text-link directory-toolbar-link" href={withBasePath('/blog/')}>Open the full archive</a>
        </div>
      </div>
    </div>

    <PostList documents={latestDocuments} />
  </section>

  {tags.length > 0 && (
    <section class="section editorial-section">
      <div class="section-rail">
        <div class="section-rail-head">
          <p class="eyebrow">Topics</p>
        </div>
        <div class="section-rail-body">
          <div class="tag-cloud">
            {tags.map((item) => (
              <a class="tag-chip" href={item.href}>
                <span>{item.tag}</span>
                <span class="tag-count">{item.count}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {seriesRows.length > 0 && (
    <section class="section editorial-section">
      <div class="section-rail">
        <div class="section-rail-intro">
          <div class="section-rail-head">
            <p class="eyebrow">Series</p>
            <h2 class="section-title">一个主题，写到底。</h2>
          </div>
          <a class="text-link" href={withBasePath('/series/')}>All series</a>
        </div>
        <div class="section-rail-body">
          <div class="series-list">
            {seriesRows.map((row, index) => (
              <article class="series-row">
                <p class="series-index">{String(index + 1).padStart(2, '0')}</p>
                <div class="series-row-body">
                  <h3>
                    <a href={row.href}>{row.entry.data.title}</a>
                  </h3>
                  <p class="series-row-description">{row.entry.data.description}</p>
                  <p class="series-row-meta">
                    <span>{row.count} {row.count === 1 ? 'part' : 'parts'}</span>
                    {row.updatedLabel && <span>Updated {row.updatedLabel}</span>}
                  </p>
                </div>
                <a class="series-row-link text-link" href={row.href}>Open series</a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
