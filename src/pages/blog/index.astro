---
import { getCollection } from 'astro:content';
import BlogDirectory from '../../components/BlogDirectory.astro';
import type { TimelineItem } from '../../components/ArchiveList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../site.config';
import { formatDate, getPostsInSeries, getSeriesUpdatedDate, sortPosts } from '../../utils/content';
import { buildSearchDocument } from '../../utils/search';
import { getBlogCollectionJsonLd, getBreadcrumbJsonLd } from '../../utils/structured-data';

const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const documents = posts.map((post) => buildSearchDocument(post));
const documentById = new Map(documents.map((document) => [document.id, document]));
const seriesById = new Map(
  (await getCollection('series', ({ data }) => !data.draft)).map((entry) => [entry.id, entry])
);

// Timeline: standalone posts stay chronological; a series appears once as a
// thread, positioned at its newest post.
const items: TimelineItem[] = [];
const threadedSeries = new Set<string>();

for (const post of posts) {
  const seriesId = post.data.series;
  const seriesEntry = seriesId ? seriesById.get(seriesId) : undefined;

  if (seriesEntry && seriesId) {
    if (threadedSeries.has(seriesId)) {
      continue;
    }

    threadedSeries.add(seriesId);
    const seriesPosts = getPostsInSeries(posts, seriesId);
    const updatedAt = getSeriesUpdatedDate(seriesPosts);

    items.push({
      kind: 'series',
      id: seriesId,
      title: seriesEntry.data.title,
      description: seriesEntry.data.description,
      updatedLabel: updatedAt ? formatDate(updatedAt, 'en') : undefined,
      documents: seriesPosts
        .map((seriesPost) => documentById.get(seriesPost.id))
        .filter((document): document is NonNullable<typeof document> => Boolean(document))
    });
    continue;
  }

  const document = documentById.get(post.id);

  if (document) {
    items.push({ kind: 'post', document });
  }
}
const siteOrigin = Astro.site ?? new URL(siteConfig.siteUrl);
const jsonLd = [
  getBlogCollectionJsonLd(siteOrigin, posts),
  getBreadcrumbJsonLd([
    { name: 'Home', url: new URL(import.meta.env.BASE_URL, siteOrigin).toString() },
    { name: 'Blog', url: new URL('blog/', new URL(import.meta.env.BASE_URL, siteOrigin)).toString() }
  ])
];
---

<BaseLayout
  title="Blog"
  description="全部文章的完整索引，支持标题、标签、中文与拼音搜索。"
  keywords={['blog', 'technical writing', 'directory', 'search', 'notes']}
  jsonLd={jsonLd}
  lang="zh-CN"
>
  <section class="editorial-hero">
    <div class="editorial-hero-main">
      <p class="eyebrow">Blog</p>
      <h1>全部文章。</h1>
    </div>
    <div class="editorial-hero-side">
      <p class="section-copy">完整索引。需要时用搜索，平时当目录读；专题会折叠成一组。</p>
    </div>
  </section>

  <BlogDirectory documents={documents} items={items} />
</BaseLayout>
