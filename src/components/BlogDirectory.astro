---
import ArchiveList from './ArchiveList.astro';
import type { TimelineItem } from './ArchiveList.astro';
import type { SearchDocument } from '../utils/search';
import { withBasePath } from '../utils/content';

interface Props {
  documents: SearchDocument[];
  items: TimelineItem[];
}

const { documents, items } = Astro.props;
const initialStatusText =
  documents.length === 1 ? '1 post in the archive.' : `${documents.length} posts in the archive.`;
---

<section
  class="directory-shell"
  data-directory-shell
  data-search-endpoint={withBasePath('/search-index.json')}
>
  <div class="directory-toolbar">
    <div class="directory-toolbar-copy">
      <p class="eyebrow">Archive</p>
      <div class="directory-toolbar-meta">
        <p class="search-note" data-search-status data-default-status={initialStatusText}>
          {initialStatusText}
        </p>
      </div>
    </div>

    <div class="directory-toolbar-actions">
      <div class="directory-searchbox">
        <button
          class="icon-button search-toggle"
          type="button"
          data-search-toggle
          aria-expanded="false"
          aria-controls="blog-search-panel"
          aria-label="Open search"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="m16 16 4.2 4.2"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.8"
            />
            <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" />
          </svg>
          <span class="sr-only">Search posts</span>
        </button>

        <div id="blog-search-panel" class="search-panel" data-search-panel hidden>
          <label class="sr-only" for="blog-search">Search posts</label>
          <input
            id="blog-search"
            class="search-input"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="Title, tag, 中文, pinyin…"
          />
          <button
            class="icon-button search-clear"
            type="button"
            data-clear-search
            hidden
            aria-label="Clear search"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="m6.5 6.5 11 11m0-11-11 11"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-width="1.8"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="directory-layout" data-directory-root>
    <ArchiveList items={items} />
  </div>
</section>

<script>
  // @ts-nocheck
  import { searchIndexDetailed } from '../utils/client-search';

  const shell = document.querySelector('[data-directory-shell]');

  if (shell) {
    const root = shell.querySelector('[data-directory-root]');
    const input = /** @type {HTMLInputElement | null} */ (document.getElementById('blog-search'));
    const searchToggle = shell.querySelector('[data-search-toggle]');
    const searchPanel = shell.querySelector('[data-search-panel]');
    const clearButton = shell.querySelector('[data-clear-search]');
    const status = shell.querySelector('[data-search-status]');
    const defaultStatus = status?.getAttribute('data-default-status') ?? '';
    const entries = new Map(
      [...(root?.querySelectorAll('[data-directory-entry]') ?? [])].map((element) => [
        element.getAttribute('data-post-id'),
        element
      ])
    );
    const allIds = [...entries.keys()];

    // The search index is fetched lazily the first time search is opened,
    // so the archive page itself stays small.
    let indexEntries = null;
    let indexPromise = null;

    const ensureIndex = () => {
      indexPromise ??= fetch(shell.getAttribute('data-search-endpoint'))
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        })
        .then((data) => {
          indexEntries = data;
        })
        .catch(() => {
          indexPromise = null;

          if (status) status.textContent = 'Search index failed to load. Try again.';
        });

      return indexPromise;
    };

    const setSearchOpen = (open, options = {}) => {
      if (!searchPanel || !searchToggle) return;

      shell.classList.toggle('is-search-open', open);
      searchPanel.hidden = !open;
      searchToggle.setAttribute('aria-expanded', String(open));
      searchToggle.setAttribute('aria-label', open ? 'Close search' : 'Open search');

      if (open) {
        ensureIndex();

        if (options.focus) {
          requestAnimationFrame(() => input?.focus());
        }
      }
    };

    // Search filters in place (entries keep their chronological/year grouping);
    // empty year groups and series threads are hidden by CSS.
    const filterList = (visibleIds) => {
      const visible = new Set(visibleIds);

      for (const [id, entry] of entries) {
        if (visible.has(id)) entry.removeAttribute('hidden');
        else entry.setAttribute('hidden', '');
      }
    };

    // Renders "where it matched" evidence under a result row: up to three
    // section snippets with the query highlighted, deep-linking to the
    // heading anchor so readers can judge relevance before opening.
    const renderSnippets = (entry, result) => {
      let box = entry.querySelector('[data-search-snippets]');

      if (!result || result.sections.length === 0) {
        box?.remove();
        return;
      }

      if (!box) {
        box = document.createElement('div');
        box.className = 'search-snippets';
        box.setAttribute('data-search-snippets', '');
        entry.appendChild(box);
      }

      box.textContent = '';
      const baseHref = entry.querySelector('a[href]')?.getAttribute('href') ?? '#';

      for (const section of result.sections) {
        const link = document.createElement('a');
        link.className = 'search-snippet';
        link.href = section.anchor ? `${baseHref}#${section.anchor}` : baseHref;

        const headingEl = document.createElement('span');
        headingEl.className = 'search-snippet-heading';
        headingEl.textContent = section.heading || 'Intro';

        const textEl = document.createElement('span');
        textEl.className = 'search-snippet-text';

        for (const part of section.parts) {
          if (part.marked) {
            const mark = document.createElement('mark');
            mark.textContent = part.text;
            textEl.appendChild(mark);
          } else {
            textEl.appendChild(document.createTextNode(part.text));
          }
        }

        link.append(headingEl, textEl);
        box.appendChild(link);
      }

      if (result.extraMatchCount > 0) {
        const more = document.createElement('p');
        more.className = 'search-snippets-more';
        more.textContent = `+ ${result.extraMatchCount} more matching section${
          result.extraMatchCount === 1 ? '' : 's'
        }`;
        box.appendChild(more);
      }
    };

    const clearSnippets = () => {
      for (const [, entry] of entries) {
        entry.querySelector('[data-search-snippets]')?.remove();
      }
    };

    const openThreadsForSearch = () => {
      document.querySelectorAll('[data-series-thread]').forEach((thread) => {
        thread.open = true;
      });
    };

    const updateSearch = () => {
      if (!status) return;

      const query = input?.value.trim() ?? '';
      clearButton?.toggleAttribute('hidden', query.length === 0);

      if (!query) {
        filterList(allIds);
        clearSnippets();
        status.textContent = defaultStatus;
        return;
      }

      if (!indexEntries) {
        status.textContent = 'Loading search index…';
        ensureIndex()?.then(() => {
          if (indexEntries) updateSearch();
        });
        return;
      }

      const results = searchIndexDetailed(indexEntries, query);
      const resultById = new Map(results.map((result) => [result.id, result]));

      filterList([...resultById.keys()]);
      openThreadsForSearch();

      for (const [id, entry] of entries) {
        renderSnippets(entry, resultById.get(id));
      }

      status.textContent =
        results.length > 0
          ? `${results.length} results for "${query}" — matching sections shown inline.`
          : `No results for "${query}". Try title, tag, Chinese, or pinyin.`;
    };

    searchToggle?.addEventListener('click', () => {
      const isOpen = shell.classList.contains('is-search-open');

      if (isOpen) {
        if (input) input.value = '';
        updateSearch();
        setSearchOpen(false);
        searchToggle.focus();
        return;
      }

      setSearchOpen(true, { focus: true });
    });

    clearButton?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      updateSearch();
      input.focus();
    });

    input?.addEventListener('input', updateSearch);

    document.addEventListener('click', (event) => {
      if (!shell.contains(event.target) && !input?.value.trim()) setSearchOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && shell.classList.contains('is-search-open')) {
        if (input) input.value = '';
        updateSearch();
        setSearchOpen(false);
        searchToggle?.focus();
        return;
      }

      if (event.defaultPrevented) return;

      const target = event.target;
      const isTyping =
        target instanceof HTMLElement &&
        (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);
      const slashPressed = event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey;
      const commandKPressed = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';

      if ((slashPressed && !isTyping) || commandKPressed) {
        event.preventDefault();
        setSearchOpen(true, { focus: true });
      }
    });
  }
</script>
