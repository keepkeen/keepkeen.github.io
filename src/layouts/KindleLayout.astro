---
import katexStylesheet from 'katex/dist/katex.min.css?url';

import { normalizeHtmlLang, withBasePath } from '../utils/content';
import { siteConfig } from '../site.config';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  canonicalPath?: string;
  loadKatex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  lang = 'zh-CN',
  canonicalPath = '/blog/',
  loadKatex = false
} = Astro.props;
const siteOrigin = Astro.site ?? new URL(siteConfig.siteUrl);
const canonical = new URL(canonicalPath, siteOrigin).toString();
const kindleHome = withBasePath('/kindle/');
const kindleArchive = withBasePath('/kindle/archive/');
const standardSite = withBasePath('/blog/');
---

<!doctype html>
<html lang={normalizeHtmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Kindle | {siteConfig.name}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    {loadKatex && <link rel="stylesheet" href={katexStylesheet} />}
    <style is:inline>
      * {
        box-sizing: border-box;
      }

      html {
        background: #fff;
        color: #111;
        font-size: 112.5%;
        scroll-behavior: auto;
      }

      body {
        max-width: 43rem;
        margin: 0 auto;
        padding: 0 1rem 5rem;
        background: #fff;
        color: #111;
        font-family: Georgia, 'Songti SC', 'STSong', 'SimSun', serif;
        line-height: 1.72;
      }

      a {
        color: #000;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.16em;
      }

      a:focus,
      a:active {
        outline: 3px solid #000;
        outline-offset: 3px;
      }

      .skip-link {
        position: absolute;
        left: -9999px;
      }

      .skip-link:focus {
        position: static;
        display: block;
        padding: 0.7rem;
        border: 2px solid #000;
      }

      .kindle-header {
        padding: 1rem 0;
        border-bottom: 2px solid #111;
      }

      .kindle-brand {
        display: block;
        margin-bottom: 0.55rem;
        font-size: 1.15rem;
        font-weight: 700;
        text-decoration: none;
      }

      .kindle-nav {
        display: flex;
        flex-wrap: wrap;
        font-family: Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
        font-size: 0.9rem;
      }

      .kindle-nav a {
        margin: 0 1rem 0.35rem 0;
      }

      main {
        padding: 1.6rem 0 2.4rem;
      }

      .kindle-footer {
        padding: 1rem 0 2rem;
        border-top: 1px solid #777;
        font-family: Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
        font-size: 0.8rem;
      }

      .kindle-pager {
        position: fixed;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 20;
        padding: 0.35rem;
        border-top: 3px solid #111;
        background: #fff;
        text-align: center;
      }

      .kindle-pager button {
        width: 46%;
        min-height: 3.1rem;
        margin: 0 1%;
        border: 2px solid #111;
        border-radius: 0;
        background: #fff;
        color: #000;
        font-family: Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
        font-size: 1rem;
        font-weight: 700;
      }

      .eyebrow,
      .meta,
      .post-meta,
      .post-description,
      .article-lead,
      .caption {
        font-family: Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
      }

      .eyebrow {
        margin: 0 0 0.55rem;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      h4 {
        color: #000;
        line-height: 1.3;
      }

      h1 {
        margin: 0 0 0.9rem;
        font-size: 1.72rem;
      }

      h2 {
        margin: 2rem 0 0.7rem;
        padding-bottom: 0.2rem;
        border-bottom: 1px solid #999;
        font-size: 1.35rem;
      }

      h3 {
        margin: 1.6rem 0 0.55rem;
        font-size: 1.16rem;
      }

      p,
      ul,
      ol,
      blockquote,
      pre,
      table {
        margin-top: 0;
        margin-bottom: 1rem;
      }

      ul,
      ol {
        padding-left: 1.35rem;
      }

      li + li {
        margin-top: 0.35rem;
      }

      .intro,
      .article-lead {
        font-size: 1.04rem;
      }

      .meta,
      .post-meta,
      .caption {
        color: #333;
        font-size: 0.8rem;
      }

      .post-list,
      .archive-list {
        margin: 1.4rem 0;
        padding: 0;
        list-style: none;
      }

      .post-item {
        padding: 1rem 0;
        border-top: 1px solid #999;
      }

      .post-item:first-child {
        border-top: 2px solid #111;
      }

      .post-title {
        display: inline-block;
        margin: 0.15rem 0 0.4rem;
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.38;
      }

      .post-description {
        margin: 0;
        color: #222;
        font-size: 0.9rem;
        line-height: 1.62;
      }

      .action-link {
        display: inline-block;
        min-height: 2.7rem;
        padding: 0.55rem 0.8rem;
        border: 2px solid #111;
        font-family: Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
        font-weight: 700;
        text-decoration: none;
      }

      .article-header {
        padding-bottom: 1.25rem;
        border-bottom: 2px solid #111;
      }

      .article-body {
        padding-top: 0.4rem;
      }

      .article-body a {
        word-break: break-word;
        overflow-wrap: anywhere;
      }

      .article-body img,
      .article-body svg,
      .article-body video {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 1rem auto;
      }

      .article-body blockquote {
        margin-left: 0;
        padding: 0.15rem 0 0.15rem 0.8rem;
        border-left: 4px solid #444;
      }

      code,
      pre {
        font-family: 'Courier New', monospace;
      }

      :not(pre) > code {
        padding: 0.08rem 0.2rem;
        border: 1px solid #aaa;
        background: #f4f4f4;
        font-size: 0.9em;
      }

      pre,
      pre.astro-code {
        max-width: 100%;
        padding: 0.75rem;
        word-break: break-word;
        overflow-wrap: anywhere;
        border: 1px solid #777;
        background: #f4f4f4 !important;
        color: #111 !important;
        font-size: 0.78rem;
        line-height: 1.45;
        white-space: pre-wrap;
      }

      pre *,
      pre.astro-code * {
        background: transparent !important;
        color: #111 !important;
      }

      table {
        display: block;
        width: 100%;
        overflow-x: auto;
        border-collapse: collapse;
        font-family: Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
        font-size: 0.78rem;
      }

      th,
      td {
        padding: 0.4rem;
        border: 1px solid #777;
        text-align: left;
        vertical-align: top;
      }

      hr {
        margin: 2rem 0;
        border: 0;
        border-top: 2px solid #777;
      }

      .post-navigation {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 2px solid #111;
      }

      .post-navigation p {
        margin-bottom: 0.8rem;
      }

      .standard-link {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #999;
      }

      @media (max-width: 28rem) {
        html {
          font-size: 106.25%;
        }

        body {
          padding: 0 0.75rem 5rem;
        }

        h1 {
          font-size: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <header class="kindle-header">
      <a class="kindle-brand" href={kindleHome}>{siteConfig.name} · Kindle 阅读版</a>
      <nav class="kindle-nav" aria-label="Kindle navigation">
        <a href={kindleHome}>最新文章</a>
        <a href={kindleArchive}>全部文章</a>
        <a href={standardSite}>标准网页</a>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="kindle-footer">
      <p>纯静态内容、无网页字体，仅保留电子墨水屏翻页控制。</p>
    </footer>
    <nav class="kindle-pager" aria-label="整屏翻页">
      <button id="kindle-page-up" type="button">↑ 上一屏</button>
      <button id="kindle-page-down" type="button">下一屏 ↓</button>
    </nav>
    <script is:inline>
      (function () {
        function turnKindlePage(direction) {
          var viewport = window.innerHeight || document.documentElement.clientHeight || 800;
          window.scrollBy(0, Math.round(viewport * 0.86) * direction);
        }

        function handleKindlePageTurn(event) {
          if (event.source !== window.parent) {
            return;
          }

          var direction = 0;
          if (event.data === 'keepkeen:page-down') {
            direction = 1;
          } else if (event.data === 'keepkeen:page-up') {
            direction = -1;
          }

          if (direction !== 0) {
            turnKindlePage(direction);
          }
        }

        var pageUp = document.getElementById('kindle-page-up');
        var pageDown = document.getElementById('kindle-page-down');
        if (pageUp) {
          pageUp.onclick = function () {
            turnKindlePage(-1);
          };
        }
        if (pageDown) {
          pageDown.onclick = function () {
            turnKindlePage(1);
          };
        }

        if (window.addEventListener) {
          window.addEventListener('message', handleKindlePageTurn, false);
        }
      })();
    </script>
  </body>
</html>
