---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';
import {
  formatDate,
  getPostLang,
  getPostPath,
  getPostsInSeries,
  getReadingTime,
  getRelatedPosts,
  getSeriesPath,
  getTagPath,
  postHasMath
} from '../utils/content';
import type { Post } from '../utils/content';
import { siteConfig } from '../site.config';
import { getBlogPostingJsonLd, getBreadcrumbJsonLd, getPostSocialImage } from '../utils/structured-data';

interface Props {
  post: Post;
  headings?: { depth: number; slug: string; text: string }[];
  previous?: Post;
  next?: Post;
}

const { post, headings = [], previous, next } = Astro.props;
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const siteOrigin = Astro.site ?? new URL(siteConfig.siteUrl);
const postUrl = new URL(getPostPath(post), siteOrigin).toString();
const lang = getPostLang(post);
const isZh = lang.startsWith('zh');
const labels = isZh
  ? {
      eyebrow: '文章',
      readingTime: `约 ${getReadingTime(post.body)} 分钟`,
      onThisPage: '本页目录',
      previous: '上一篇',
      next: '下一篇',
      noPrevious: '没有更早的文章了。',
      noNext: '这已经是最新一篇。',
      seriesLabel: '专题',
      seriesPart: (part: number, total: number) => `第 ${part} 篇 / 共 ${total} 篇`,
      inThisSeries: '本专题目录',
      currentPart: '本篇',
      related: '相关文章',
      comments: '评论'
    }
  : {
      eyebrow: 'Essay',
      readingTime: `${getReadingTime(post.body)} min read`,
      onThisPage: 'On this page',
      previous: 'Previous',
      next: 'Next',
      noPrevious: 'No earlier essay yet.',
      noNext: 'You are at the latest note.',
      seriesLabel: 'Series',
      seriesPart: (part: number, total: number) => `Part ${part} of ${total}`,
      inThisSeries: 'In this series',
      currentPart: 'Reading',
      related: 'Related essays',
      comments: 'Comments'
    };

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const seriesEntry = post.data.series ? await getEntry('series', post.data.series) : undefined;
const seriesPosts =
  seriesEntry && !seriesEntry.data.draft ? getPostsInSeries(allPosts, seriesEntry.id) : [];
const seriesPosition = seriesPosts.findIndex((item) => item.id === post.id) + 1;
const showSeries = Boolean(seriesEntry) && seriesPosition > 0;
const seriesIds = new Set(seriesPosts.map((item) => item.id));
const relatedPosts = getRelatedPosts(post, allPosts, 3).filter((item) => !seriesIds.has(item.id));
const loadKatex = postHasMath(post);
const loadMonoFont = /```/.test(post.body ?? '');
const jsonLd = [
  getBlogPostingJsonLd(siteOrigin, post),
  getBreadcrumbJsonLd([
    { name: 'Home', url: new URL(import.meta.env.BASE_URL, siteOrigin).toString() },
    { name: 'Blog', url: new URL('blog/', new URL(import.meta.env.BASE_URL, siteOrigin)).toString() },
    { name: post.data.title, url: postUrl }
  ])
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  pageClass="page-article"
  ogType="article"
  keywords={post.data.tags}
  publishedTime={post.data.date}
  modifiedTime={post.data.updatedDate ?? post.data.date}
  articleTags={post.data.tags}
  jsonLd={jsonLd}
  lang={lang}
  image={getPostSocialImage(siteOrigin, post)}
  loadKatex={loadKatex}
  loadMonoFont={loadMonoFont}
>
  <article class="article-shell">
    <header class="article-intro">
      <p class="eyebrow">{labels.eyebrow}</p>
      <h1>{post.data.title}</h1>
      <p class="article-lead">{post.data.description}</p>
      <div class="meta-row">
        <span>{formatDate(post.data.date, lang)}</span>
        <span>{labels.readingTime}</span>
        <span class="article-tags">
          {post.data.tags.map((tag, index) => (
            <>
              {index > 0 && ' / '}
              <a class="text-link" href={getTagPath(tag)}>{tag}</a>
            </>
          ))}
        </span>
      </div>

      {showSeries && seriesEntry && (
        <p class="article-series">
          <span class="article-series-label">{labels.seriesLabel}</span>
          <a href={getSeriesPath(seriesEntry.id)}>{seriesEntry.data.title}</a>
          <span class="article-series-part">{labels.seriesPart(seriesPosition, seriesPosts.length)}</span>
        </p>
      )}
    </header>

    <div class:list={['article-layout', tableOfContents.length === 0 && 'article-layout-single']}>
      {tableOfContents.length > 0 && (
        <aside class="article-sidebar">
          <nav class="article-toc" aria-label={labels.onThisPage} data-toc>
            <p class="panel-label">{labels.onThisPage}</p>
            <ol>
              {tableOfContents.map((heading) => (
                <li class:list={[heading.depth === 3 && 'is-sub-item']}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>

          <details class="article-toc-mobile">
            <summary>{labels.onThisPage}</summary>
            <ol>
              {tableOfContents.map((heading) => (
                <li class:list={[heading.depth === 3 && 'is-sub-item']}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </details>
        </aside>
      )}

      <div class="prose">
        <slot />
      </div>
    </div>

    {showSeries && seriesEntry && (
      <aside class="series-panel" aria-label={labels.inThisSeries}>
        <div class="series-panel-head">
          <p class="panel-label">{labels.inThisSeries}</p>
          <a class="text-link" href={getSeriesPath(seriesEntry.id)}>{seriesEntry.data.title}</a>
        </div>
        <ol class="series-panel-list">
          {seriesPosts.map((item, index) => (
            <li class:list={['series-panel-item', item.id === post.id && 'is-current']}>
              <span class="series-panel-index">{String(index + 1).padStart(2, '0')}</span>
              {item.id === post.id ? (
                <span class="series-panel-title" aria-current="page">
                  {item.data.title}
                  <span class="series-panel-marker">{labels.currentPart}</span>
                </span>
              ) : (
                <a class="series-panel-title" href={getPostPath(item)}>
                  {item.data.title}
                </a>
              )}
            </li>
          ))}
        </ol>
      </aside>
    )}

    {relatedPosts.length > 0 && (
      <aside class="related-panel" aria-label={labels.related}>
        <p class="panel-label">{labels.related}</p>
        <ul class="related-list">
          {relatedPosts.map((item) => (
            <li class="related-item">
              <a href={getPostPath(item)}>{item.data.title}</a>
              <span>{formatDate(item.data.date, 'en')}</span>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <nav class="article-navigation" aria-label="Post navigation">
      <div class="nav-stack">
        <p class="panel-label">{labels.previous}</p>
        {
          previous ? (
            <a class="text-link" href={getPostPath(previous)}>
              {previous.data.title}
            </a>
          ) : (
            <span class="caption">{labels.noPrevious}</span>
          )
        }
      </div>

      <div class="nav-stack">
        <p class="panel-label">{labels.next}</p>
        {
          next ? (
            <a class="text-link" href={getPostPath(next)}>
              {next.data.title}
            </a>
          ) : (
            <span class="caption">{labels.noNext}</span>
          )
        }
      </div>
    </nav>

    <Comments lang={lang} label={labels.comments} />
  </article>
</BaseLayout>

<script>
  // Scroll spy: highlight the table-of-contents entry for the section in view.
  const toc = document.querySelector('[data-toc]');

  if (toc) {
    const links = new Map(
      [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')].map((link) => [
        decodeURIComponent(link.hash.slice(1)),
        link
      ])
    );
    const headings = [...document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')].filter(
      (heading) => links.has(heading.id)
    );

    if (headings.length > 0) {
      let currentId: string | null = null;

      const update = () => {
        const offset = 110;
        let activeId = headings[0].id;

        for (const heading of headings) {
          if (heading.getBoundingClientRect().top <= offset) activeId = heading.id;
          else break;
        }

        if (activeId === currentId) return;
        currentId = activeId;

        for (const [id, link] of links) {
          link.classList.toggle('is-current', id === activeId);
        }
      };

      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }
  }
</script>
